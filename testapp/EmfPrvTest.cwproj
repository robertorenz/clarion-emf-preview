<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{7A1B2C3D-0000-4000-8000-000000000003}</ProjectGuid>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">Win32</Platform>
    <OutputType>Exe</OutputType>
    <RootNamespace>EmfPrvTest</RootNamespace>
    <AssemblyName>EmfPrvTest</AssemblyName>
    <OutputName>EmfPrvTest</OutputName>
    <DefineConstants>_ABCDllMode_=&gt;0%3b_ABCLinkMode_=&gt;1%3b_EmfPrvDllMode_=&gt;0%3b_EmfPrvLinkMode_=&gt;1</DefineConstants>
    <CopyCore>True</CopyCore>
    <stack_size>16384</stack_size>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>True</DebugSymbols>
    <DebugType>Full</DebugType>
    <vid>full</vid>
    <warnings>on</warnings>
    <GenerateMap>False</GenerateMap>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="EmfPrvTest.clw" />
    <Compile Include="EmfPrvTest001.clw" />
    <Compile Include="EmfPrvTest_BC0.CLW" />
    <Compile Include="EMFPRVTEST_BC.CLW" />
  </ItemGroup>
  <ItemGroup>
    <FileDriver Include="TOPSPEED" />
  </ItemGroup>
  <Import Project="$(ClarionBinPath)\SoftVelocity.Build.Clarion.targets" />
</Project>
