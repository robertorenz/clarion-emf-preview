[EMBED]
EMBED %WindowManagerMethodCodeSection
[INSTANCES]
WHEN 'Init'
[INSTANCES]
WHEN '(),BYTE'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 8000
PROPERTY:END
! test data: 120 customers
IF RECORDS(Customers) = 0
  LOOP FillIdx = 1 TO 120
    CUS:Id     = FillIdx
    CUS:Name   = 'Customer ' & FillIdx
    CUS:City   = CHOOSE((FillIdx - 1) % 4 + 1, 'Zurich', 'Athens', 'Tokyo', 'Moscow')
    CUS:Amount = FillIdx * 12.5
    Access:Customers.Insert()
  END
END
HdrSub = U'Unicode ready - <917><955><955><951><957><953><954><940> <8226> <1056><1091><1089><1089><1082><1080><1081> <8226> <20013><25991> <8226> <26085><26412><35486> <8226> Emoji ' & UCHR(1F600h)
[END]
[END]
[END]
EMBED %ProcessManagerMethodCodeSection
[INSTANCES]
WHEN 'TakeRecord'
[INSTANCES]
WHEN '(),BYTE'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 4900
PROPERTY:END
! a wide detail value: ANSI file data widened + exact Unicode text
CASE (CUS:Id - 1) % 4
OF 0
  DtlName = CLIP(CUS:Name) & U' <8211> Ana M<252>ller'
OF 1
  DtlName = CLIP(CUS:Name) & U' <8211> <915><953><974><961><947><959><962> <928><945><960><945><948><972><960><959><965><955><959><962>'
OF 2
  DtlName = CLIP(CUS:Name) & U' <8211> <23665><30000> <22826><37070>'
ELSE
  DtlName = CLIP(CUS:Name) & U' <8211> <1044><1084><1080><1090><1088><1080><1081> <1048><1074><1072><1085><1086><1074>'
END
[END]
[END]
[END]
[END]
[WINDOW]
ProgressWindow WINDOW('Printing customers...'),AT(,,142,59),FONT('Segoe UI',9,,FONT:regular, |
          CHARSET:DEFAULT),DOUBLE,GRAY,TIMER(1)
          PROGRESS,AT(10,15,121,9),USE(Progress:Thermometer),RANGE(0,100),#ORIG(Progress:Thermometer)
          STRING(''),AT(0,3,141,10),USE(?Progress:UserString),CENTER,TRN,#ORIG(?Progress:UserString)
          STRING(''),AT(0,30,141,10),USE(?Progress:PctText),CENTER,TRN,#ORIG(?Progress:PctText)
          BUTTON('Cancel'),AT(46,42,50,14),USE(?Progress:Cancel),#ORIG(?Progress:Cancel)
        END

[REPORT]
Report  REPORT,AT(500,1000,7500,9000),PRE(RPT),FONT('Segoe UI',10,,FONT:regular,CHARSET:DEFAULT), |
          THOUS,UNICODE
          HEADER,AT(500,250,7500,700),USE(?Header)
            STRING('Customers - EMF Unicode previewer template test'),AT(0,0,7500,300),USE(?Title), |
              FONT(,14,,FONT:bold),CENTER
            STRING(@s120),AT(0,350,7500,250),USE(HdrSub),CENTER
            LINE,AT(0,650,7500,0),USE(?HdrLine),COLOR(COLOR:Navy)
          END
detail    DETAIL,AT(,,7500,300),USE(?detail)
            STRING(@n_8),AT(0,20,600,250),USE(CUS:Id),RIGHT
            STRING(@s90),AT(800,20,4200,250),USE(DtlName)
            STRING(@s40),AT(5100,20,1300,250),USE(CUS:City)
            STRING(@n-14.2),AT(6400,20,1100,250),USE(CUS:Amount),RIGHT
          END
          FOOTER,AT(500,10250,7500,400),USE(?Footer)
            LINE,AT(0,20,7500,0),USE(?FtrLine),COLOR(COLOR:Navy)
            STRING('Page'),AT(0,80,400,250),USE(?PageLbl)
            STRING(@n3),AT(400,80,500,250),USE(?PageNo),PAGENO
          END
        END

[END]
